# Neon Postgres connection string
DATABASE_URL=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Public URL of the site (used for the Google OAuth redirect), e.g. https://www.theblinkx.com
APP_URL=
# Google Cloud OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
